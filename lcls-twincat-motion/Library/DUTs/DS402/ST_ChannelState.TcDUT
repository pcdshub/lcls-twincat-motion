    {attribute 'pytmc' := '
        pv: bReferencing
        io: i
        field: DESC Referencing
    '}
    bReferencing            : BOOL;
    {attribute 'pytmc' := '
        pv: bMoveDelayed
        io: i
        field: DESC Move delayed
    '}
    bMoveDelayed            : BOOL;
    {attribute 'pytmc' := '
        pv: bSensorPresent
        io: i
        field: DESC Sensor present
    '}
    bSensorPresent          : BOOL;
    {attribute 'pytmc' := '
        pv: bIsCalibrated
        io: i
        field: DESC Is calibrated
    '}
