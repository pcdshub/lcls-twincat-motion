<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_ChannelState" Id="{57a8c6a5-d804-4041-a922-2988413bdf86}">
    <Declaration><![CDATA[TYPE ST_ChannelState :
STRUCT
    {attribute 'pytmc' := '
        pv: STATE
        io: i
        field: DESC Channel state raw
    '}
    nChannelStateRaw  : DWORD;

    {attribute 'pytmc' := '
        pv: MOVING
        io: i
        field: DESC Actively moving
    '}
    bActivelyMoving         : BOOL;
    {attribute 'pytmc' := '
        pv: CLOSED_LOOP
        io: i
        field: DESC Closed loop active
    '}
    bClosedLoopActive       : BOOL;
    {attribute 'pytmc' := '
        pv: CALIBRATING
        io: i
        field: DESC Calibrating
    '}
    bCalibrating            : BOOL;
    {attribute 'pytmc' := '
        pv: REFERENCING
        io: i
        field: DESC Referencing
    '}
    bReferencing            : BOOL;
    {attribute 'pytmc' := '
        pv: MOVE_DELAYED
        io: i
        field: DESC Move delayed
    '}
    bMoveDelayed            : BOOL;
    {attribute 'pytmc' := '
        pv: SENSOR_PRESENT
        io: i
        field: DESC Sensor present
    '}
    bSensorPresent          : BOOL;
    {attribute 'pytmc' := '
        pv: CALIBRATED
        io: i
        field: DESC Is calibrated
    '}
    bIsCalibrated           : BOOL;
    {attribute 'pytmc' := '
        pv: REFERENCED
        io: i
        field: DESC Is referenced
    '}
    bIsReferenced           : BOOL;
    {attribute 'pytmc' := '
        pv: END_STOP
        io: i
        field: DESC End stop reached
    '}
    bEndStopReached         : BOOL;
    {attribute 'pytmc' := '
        pv: RANGE_LIMIT
        io: i
        field: DESC Range limit reached
    '}
    bRangeLimitReached      : BOOL;
    {attribute 'pytmc' := '
        pv: FOLLOWING_LIMIT
        io: i
        field: DESC Following limit reached
    '}
    bFollowingLimitReached  : BOOL;
    {attribute 'pytmc' := '
        pv: MOVE_FAILED
        io: i
        field: DESC Movement failed
    '}
    bMovementFailed         : BOOL;
    {attribute 'pytmc' := '
        pv: STREAMING
        io: i
        field: DESC Is streaming
    '}
    bIsStreaming            : BOOL;
    {attribute 'pytmc' := '
        pv: OVERLOAD
        io: i
        field: DESC Positioner overload
    '}
    bPositionerOverload     : BOOL;
    {attribute 'pytmc' := '
        pv: OVER_TEMP
        io: i
        field: DESC Over temperature
    '}
    bOverTemperature        : BOOL;
    {attribute 'pytmc' := '
        pv: REF_MARK
        io: i
        field: DESC Reference mark
    '}
    bReferenceMark          : BOOL;
    {attribute 'pytmc' := '
        pv: PHASED
        io: i
        field: DESC Is phased
    '}
    bIsPhased               : BOOL;
    {attribute 'pytmc' := '
        pv: FAULT
        io: i
        field: DESC Positioner fault
    '}
    bPositionerFault        : BOOL;
    {attribute 'pytmc' := '
        pv: AMP_ENABLED
        io: i
        field: DESC Amplifier enabled
    '}
    bAmplifierEnabled       : BOOL;
    {attribute 'pytmc' := '
        pv: IN_POSITION
        io: i
        field: DESC In position
    '}
    bInPosition             : BOOL;
    {attribute 'pytmc' := '
        pv: BRAKE_ENABLED
        io: i
        field: DESC Brake enabled
    '}
    bBrakeEnabled           : BOOL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>