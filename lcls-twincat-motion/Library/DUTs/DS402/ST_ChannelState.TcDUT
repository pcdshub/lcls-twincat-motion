        io: i
        field: DESC Is phased
    '}
    bIsPhased               : BOOL;
    {attribute 'pytmc' := '
        pv: bPositionerFault
        io: i
        field: DESC Positioner fault
    '}
    bPositionerFault        : BOOL;
    {attribute 'pytmc' := '
        pv: bAmplifierEnabled
        io: i
        field: DESC Amplifier enabled
    '}
    bAmplifierEnabled       : BOOL;
    {attribute 'pytmc' := '
        pv: bInPosition
        io: i
        field: DESC In position
    '}
    bInPosition             : BOOL;
    {attribute 'pytmc' := '
