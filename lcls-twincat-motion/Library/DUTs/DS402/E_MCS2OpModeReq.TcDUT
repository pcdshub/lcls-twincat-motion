<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_MCS2OpModeReq" Id="{7e3a9c14-2b6d-4f81-9a05-d3c2e1f4a6b9}">
    <Declaration><![CDATA[(*
    User-facing request for the MCS2 drive operating mode, exposed as an EPICS PV.
    This is the source of truth for which DS402 mode the drive runs in; the
    FB_MCS2DriveManager maps each value onto the corresponding E_DS402OpMode and
    switches the drive immediately when this value changes.
    CLOSED_LOOP (default) is closed-loop (CSP / NC) absolute motion.
*)
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_MCS2OpModeReq :
(
    CLOSED_LOOP := 0,
    STEP := 1,
    HOME := 2,
    CALIBRATION := 3
) SINT;
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
