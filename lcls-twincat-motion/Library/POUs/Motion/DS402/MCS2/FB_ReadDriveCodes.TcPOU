<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_ReadDriveCodes" Id="{44ddb32d-aaa2-4fc7-a16a-bf90774280d7}" SpecialFunc="None">
    <Declaration><![CDATA[(* Read Drive error codes after a motion or fault condition occured *)
FUNCTION_BLOCK FB_ReadDriveCodes
VAR_IN_OUT
    stDS402Drive         : ST_DS402Drive;
    stMotionStage        : ST_MotionStage;
    stMCS2ChanParameter	: ST_MCS2ChanParameter;
END_VAR
VAR_INPUT
    bEnable : BOOL;
END_VAR
VAR
    {attribute 'hide'}
    fbLogError          : FB_LogMotionError;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT __ISVALIDREF(stDS402Drive)
    OR NOT __ISVALIDREF(stMotionStage)
    OR NOT __ISVALIDREF(stMCS2ChanParameter) THEN
    RETURN;
END_IF

// The drive-side code (0x603F) is read by FB_ReadChanParameters on a fault or
// internal-limit event. It is decoded by its own table and never merged into
// nErrorId: the two number spaces overlap (MCS2 0x4200 sits inside the NC 0x4xxx
// family, and MCS2 manufacturer codes 0xFFxx overlap E_LCLSMotionError.TEST).
stMCS2ChanParameter.sMCS2ErrorMessage :=
    F_MCS2ErrorCodeLookup(nErrorId := stMCS2ChanParameter.nMCS2ErrorCode);]]></ST>

// sErrorMessage is the only message channel exposed to the IOC. Include both
// decoded layers when available; the numeric values remain separate in PLC:nErrorId
// and MCS2_ERR so overlapping code spaces cannot be confused.
IF stMotionStage.bError THEN
    IF stDS402Drive.stDriveStatus.InternalLimitActive
        AND stMotionStage.sCustomErrorMessage <> '' THEN
        stMotionStage.sErrorMessage := stMotionStage.sCustomErrorMessage;
        IF stMCS2ChanParameter.sMCS2ErrorMessage <> '' THEN
            stMotionStage.sErrorMessage := CONCAT(
                CONCAT(stMotionStage.sErrorMessage, ' (MCS2: '),
                CONCAT(stMCS2ChanParameter.sMCS2ErrorMessage, ')'));
        END_IF
    ELSIF stMotionStage.nErrorId >= 16#4000 THEN
        stMotionStage.sErrorMessage := F_MotionErrorCodeLookup(nErrorId := stMotionStage.nErrorId);
        IF stMCS2ChanParameter.sMCS2ErrorMessage <> '' THEN
            stMotionStage.sErrorMessage := CONCAT(
                CONCAT(stMotionStage.sErrorMessage, ' (MCS2: '),
                CONCAT(stMCS2ChanParameter.sMCS2ErrorMessage, ')'));
        END_IF
    ELSIF stMotionStage.nErrorId = 0 THEN
        stMotionStage.sErrorMessage := 'Contact PCDS to add new message';
    END_IF
END_IF
    </Implementation>
  </POU>
</TcPlcObject>